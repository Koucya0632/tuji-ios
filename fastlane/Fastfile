# Fastfile — Tuji iOS signing + TestFlight delivery.
#
# Signing uses fastlane match: certificates + provisioning profiles live
# encrypted in a separate private git repo (MATCH_GIT_URL) and are installed
# read-only in CI. A human runs `bootstrap_certificates` ONCE locally to create
# and push them; CI never gets write access to the signing portal.
#
# Required environment (see RELEASE.md for where each comes from):
#   MATCH_GIT_URL                  private repo holding the encrypted assets
#   MATCH_PASSWORD                 passphrase that decrypts them
#   MATCH_GIT_BASIC_AUTHORIZATION  base64("user:PAT") for HTTPS clone in CI
#   APP_STORE_CONNECT_KEY_ID       App Store Connect API key id
#   APP_STORE_CONNECT_ISSUER_ID    App Store Connect issuer id
#   APP_STORE_CONNECT_API_KEY_P8   base64 of the .p8 key file
#   TUJI_DEV_TEAM                  Apple Developer Team ID

default_platform(:ios)

# App IDs that need signing assets. Keep in sync with the xcconfig bundle IDs.
APP_IDENTIFIERS = %w[
  app.tuji.ios
].freeze

platform :ios do
  # App Store Connect API key for match (portal access) and pilot (upload).
  # Reads a base64-encoded .p8 so it travels through a single GitHub secret.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # ---------------------------------------------------------------------------
  # Signing
  # ---------------------------------------------------------------------------

  desc "Create & push signing assets to the match repo. Run ONCE, locally."
  lane :bootstrap_certificates do
    APP_IDENTIFIERS.each do |app_id|
      sync_code_signing(
        type: "appstore",
        app_identifier: app_id,
        readonly: false,
        api_key: asc_api_key
      )
    end
  end

  desc "Install existing signing assets read-only (used by CI)."
  lane :certificates do
    setup_ci
    sync_code_signing(
      type: "appstore",
      app_identifier: APP_IDENTIFIERS,
      readonly: true
    )
  end

  # ---------------------------------------------------------------------------
  # Delivery
  # ---------------------------------------------------------------------------

  desc "Build a variant and upload it to TestFlight."
  desc "Params: scheme, configuration, app_identifier (passed from release.yml)."
  lane :beta do |options|
    scheme = options.fetch(:scheme, "Tuji-TestFlight")
    configuration = options.fetch(:configuration, "TestFlight")
    app_id = options.fetch(:app_identifier, "app.tuji.ios")

    setup_ci
    api_key = asc_api_key

    sync_code_signing(
      type: "appstore",
      app_identifier: app_id,
      readonly: true
    )

    build_app(
      project: "Tuji.xcodeproj",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          app_id => "match AppStore #{app_id}"
        }
      },
      output_directory: "build",
      output_name: "Tuji.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  # ---------------------------------------------------------------------------
  # Store listing (text only)
  # ---------------------------------------------------------------------------
  # fastlane/metadata is the source of truth for the store listing text
  # (docs/adr/0017). Edit it there, never in the App Store Connect web UI:
  # the next upload overwrites whatever the web UI holds. Screenshots are
  # uploaded by hand and are not tracked.

  desc "Pull the store listing text from App Store Connect into fastlane/metadata. Read-only."
  desc "Params: live:true reads the version on sale instead of the one being edited."
  lane :metadata_download do |options|
    require "json"
    require "tempfile"

    # `deliver download_metadata` is a CLI command, not an action, and only
    # takes the API key as a JSON file.
    Tempfile.create(["asc_api_key", ".json"]) do |key_file|
      key_file.write(
        JSON.generate(
          key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
          issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
          key: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
          is_key_content_base64: true
        )
      )
      key_file.flush

      command = [
        "bundle", "exec", "fastlane", "deliver", "download_metadata",
        "--api_key_path", key_file.path,
        "--app_identifier", APP_IDENTIFIERS.first,
        "--metadata_path", "fastlane/metadata",
        "--force"
      ]
      command += ["--use_live_version", "true"] if options[:live]

      # Lanes run inside fastlane/; deliver expects the project root.
      Dir.chdir("..") { sh(*command) }
    end
  end

  desc "Push fastlane/metadata to App Store Connect. Never submits for review."
  desc "Shows an HTML preview of every field and waits for confirmation before uploading."
  desc "Params: version (the App Store version to write to; defaults to the one being edited)."
  lane :metadata_upload do |options|
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIERS.first,
      app_version: options[:version],
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: false
    )
  end
end
