# =============================================================================
# Tuji iOS — SwiftFormat
# 跑：brew install swiftformat && swiftformat .
# 檢查（不改）：swiftformat . --lint
# 安裝 git hook：echo 'swiftformat --lint .' > .git/hooks/pre-commit
# =============================================================================

# Swift 版本
--swiftversion 6.0

# ---------- 掃描 ----------
# build = 本機 / CI 的 derivedDataPath（含 SPM checkouts，數千個第三方檔案）
# build-release = pr.yml 的 release-build job 用的那一個。`build` 不會連帶
# 排除它，所以本機跑完「出得了版本嗎」那一步後，repo 根目錄直接跑
# `swiftformat . --lint`（CI 用的那條指令）會噴 10 萬個第三方檔案的 error，
# 看起來像 lint 壞了。CI 是乾淨 checkout 所以從沒中過。
#
# 最後兩個是 sync-study-choice-data.mjs 的產物，檔頂都寫著「Do not edit」和
# `// swiftformat:disable all`。那行指令管的是「結果不要套用」，不是「不要
# 跑」—— 規則照跑，跑完才被丟掉。所以這兩個檔一直在付規則的錢，而那筆錢買
# 到的東西永遠被丟掉。
#
# 會注意到是因為 CI 的 Lint 倒在
# `error: wrap rule timed out in .../StudyChoiceData.swift`：SwiftFormat 給
# 規則一個有時限的預算，而 0.61.1 沒有 --timeout 可以調。那次是 main 換上
# macos-15-intel 之後、同一批 runner 明顯變慢的一趟（Build & Test 跑了 36
# 分鐘，平常 26 分鐘）；在本機我量不出這個檔比別的檔貴多少，所以別把它當成
# 「這個檔有病」—— 它只是那趟唯一踩到預算的那個。
#
# 總之從掃描範圍拿掉才是真的不跑它，而這本來就是那行 disable 想說的事。
--exclude .build,.swiftpm,DerivedData,build,build-release,Pods,Preview\ Content,Tuji/Resources,Tuji/Core/Study/StudyChoiceData.swift,TujiTests/StudyChoiceContractCases.swift

# ---------- 通用 ----------
--indent 4
--linebreaks lf
--trimwhitespace always
--allman false
--maxwidth 120
--semicolons never
--commas inline
--ranges no-space
--operatorfunc spaced

# ---------- 引用 ----------
# redundantSelf disabled below — Swift 6.1 strict-concurrency requires
# explicit self in any closure that captures instance state (including
# OSLog Logger's autoclosure for message interpolation). Letting
# SwiftFormat touch self causes ping-pong with the compiler.
--selfrequired                      # 預留：強制 self 的閉包白名單
--importgrouping testable-bottom    # @testable import 放最後

# ---------- 屬性 / wrap ----------
# SwiftUI View body 內 modifier 鏈喜歡多行，let 鏈用 wrap
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions after-first
--wrapreturntype if-multiline
--funcattributes prev-line
--typeattributes prev-line
--storedvarattrs same-line
--computedvarattrs prev-line

# ---------- 空行 ----------
--emptybraces no-space
--anonymousforeach convert
--shortoptionals always

# ---------- 控制流 ----------
--elseposition same-line
--guardelse next-line
--ifdef no-indent

# ---------- 字串 / 數字 ----------
--stripunusedargs closure-only
--decimalgrouping 3,5
--binarygrouping none
--hexgrouping none
--octalgrouping none
--exponentgrouping disabled

# ---------- 修飾詞順序（對齊 SwiftLint modifier_order）----------
# @MainActor / nonisolated belong in attribute order, not modifier order.
# SwiftFormat's modifierorder takes Swift access/sharing modifiers only.
--modifierorder public,override,private(set),final

# ---------- 啟用 / 停用個別規則 ----------
# 不啟用：sortImports（與 SwiftLint sorted_imports 規則由 SwiftLint 管）
--enable                                                                       \
    blankLinesAtStartOfScope,                                                  \
    blankLinesAtEndOfScope,                                                    \
    blankLinesBetweenScopes,                                                   \
    consecutiveBlankLines,                                                     \
    consecutiveSpaces,                                                         \
    duplicateImports,                                                          \
    leadingDelimiters,                                                         \
    linebreakAtEndOfFile,                                                      \
    redundantBackticks,                                                        \
    redundantBreak,                                                            \
    redundantGet,                                                              \
    redundantInit,                                                             \
    redundantLet,                                                              \
    redundantNilInit,                                                          \
    redundantParens,                                                           \
    redundantPattern,                                                          \
    redundantRawValues,                                                        \
    redundantReturn,                                                           \
    redundantType,                                                             \
    redundantVoidReturnType,                                                   \
    semicolons,                                                                \
    sortDeclarations,                                                          \
    spaceAroundBraces,                                                         \
    spaceAroundBrackets,                                                       \
    spaceAroundComments,                                                       \
    spaceAroundGenerics,                                                       \
    spaceAroundOperators,                                                      \
    spaceAroundParens,                                                         \
    spaceInsideBraces,                                                         \
    spaceInsideBrackets,                                                       \
    spaceInsideComments,                                                       \
    spaceInsideGenerics,                                                       \
    spaceInsideParens,                                                         \
    todos,                                                                     \
    trailingClosures,                                                          \
    trailingCommas,                                                            \
    trailingSpace,                                                             \
    typeSugar,                                                                 \
    unusedArguments,                                                           \
    void,                                                                      \
    wrap,                                                                      \
    wrapArguments,                                                             \
    wrapMultilineStatementBraces

--disable                                                                      \
    sortImports,                                                               \
    isEmpty,                                                                   \
    wrapEnumCases,                                                             \
    blockComments,                                                             \
    redundantSelf

# ---------- 排除整檔的指令（必要時加註解）----------
# 在檔案頂部寫：
#   // swiftformat:disable all
# 或單行：
#   // swiftformat:disable:next redundantSelf
