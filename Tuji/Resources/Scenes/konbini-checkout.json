  "questions": [
    {
      "id": "konbini-checkout.heat",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問要不要加熱",
        "zh-Hans": "听懂店员问要不要加热",
        "en": "Understand when the clerk offers to heat your food"
      },
      "phrasings": [
        {
          "id": "konbini-checkout.heat.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "温めますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "konbini-checkout.heat.p1.mp3"
        },
        {
          "id": "konbini-checkout.heat.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "こちら温めますか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "konbini-checkout.heat.p2.mp3"
        },
        {
          "id": "konbini-checkout.heat.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "温めはどうされますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "konbini-checkout.heat.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要幫你加熱",
            "zh-Hans": "要不要帮你加热",
            "en": "Do you want it heated"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要不要袋子",
            "zh-Hans": "要不要袋子",
            "en": "Do you need a bag"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要附筷子或湯匙",
            "zh-Hans": "要不要附筷子或勺子",
            "en": "Do you need chopsticks or a spoon"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "お願いします／そのままで大丈夫です",
        "audio": "konbini-checkout.heat.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「温める」是加熱。要的話說「お願いします」，不用就說「そのままで大丈夫です」。",
        "zh-Hans": "「温める」是加热。要的话说「お願いします」，不用就说「そのままで大丈夫です」。",
        "en": "温める means to heat up. Say お願いします for yes, or そのままで大丈夫です to take it as it is."
      },
      "wordIds": ["microwave-station"]
    },
    {
