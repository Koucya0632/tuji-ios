          "speaker": "clerk",
          "text": "どちらまでご利用ですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "station-ticket-office.destination.p1.mp3"
        },
        {
          "id": "station-ticket-office.destination.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "行き先はどちらですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "station-ticket-office.destination.p2.mp3"
        },
        {
          "id": "station-ticket-office.destination.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "どこまで行かれますか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "station-ticket-office.destination.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要去哪裡",
            "zh-Hans": "去哪里",
            "en": "Where are you going"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "從哪一站上車",
            "zh-Hans": "从哪一站上车",
            "en": "Which station are you leaving from"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要買幾張",
            "zh-Hans": "要买几张",
            "en": "How many tickets"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "京都までお願いします",
        "audio": "station-ticket-office.destination.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「どちらまで」是問到哪裡。說站名加「までお願いします」，或遞出寫好站名、日期和時間的紙。",
        "zh-Hans": "「どちらまで」是问到哪里。说站名加「までお願いします」，或递上写好站名、日期和时间的纸条。",
        "en": "どちらまで asks where to. Say the station name plus までお願いします, or hand over a note with the station, date and time."
      },
      "wordIds": [
        "station"
      ]
    },
    {
      "id": "station-ticket-office.when",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂站務員問哪天、幾點搭車",
        "zh-Hans": "听懂工作人员问哪天、几点上车",
        "en": "Understand when the clerk asks what day and time you are travelling"
      },
      "phrasings": [
        {
          "id": "station-ticket-office.when.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ご乗車はいつですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "station-ticket-office.when.p1.mp3"
        },
        {
          "id": "station-ticket-office.when.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "ご乗車の日にちとお時間をお願いします。",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "station-ticket-office.when.p2.mp3"
        },
        {
          "id": "station-ticket-office.when.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "何日の何時ごろのご乗車ですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "station-ticket-office.when.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "哪天、幾點搭車",
            "zh-Hans": "哪天、几点上车",
            "en": "What day and time are you travelling"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "想幾點到",
            "zh-Hans": "想几点到",
            "en": "What time do you want to arrive"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要買回程票",
            "zh-Hans": "要不要买返程票",
            "en": "Do you want a return ticket"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "今日の十時ごろです",
        "audio": "station-ticket-office.when.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「ご乗車」是搭車，問的是出發的日期和時間，不是到達時間。回答例如「今日の十時ごろです」「明日の朝です」。",
        "zh-Hans": "「ご乗車」是上车，问的是出发的日期和时间，不是到达时间。回答比如「今日の十時ごろです」「明日の朝です」。",
        "en": "ご乗車 means boarding, so this asks when you leave, not when you arrive. Answer like 今日の十時ごろです or 明日の朝です."
      },
      "wordIds": [
        "departure-board"
      ]
    },
