    {
      "id": "station-ticket-office.destination",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂站務員問要去哪裡",
        "zh-Hans": "听懂工作人员问去哪里",
        "en": "Understand when the clerk asks where you are going"
      },
