  "questions": [
    {
      "id": "clothing-store.looking",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問你在找什麼",
        "zh-Hans": "听懂店员问你在找什么",
        "en": "Understand when the clerk asks what you are looking for"
      },
      "phrasings": [
        {
          "id": "clothing-store.looking.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "何かお探しですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "clothing-store.looking.p1.mp3"
        },
        {
          "id": "clothing-store.looking.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "何かお探しでしたら、お声がけください",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "clothing-store.looking.p2.mp3"
        },
        {
          "id": "clothing-store.looking.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お探しのものはございますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "clothing-store.looking.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要試穿看看",
            "zh-Hans": "要不要试穿看看",
            "en": "Would you like to try it on"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "在找什麼嗎",
            "zh-Hans": "在找什么吗",
            "en": "Are you looking for something"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要找什麼尺寸",
            "zh-Hans": "要找什么尺码",
            "en": "What size are you looking for"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "見ているだけです",
        "audio": "clothing-store.looking.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「お探し」是在找東西，「お声がけください」是需要的話叫他。只是看看就說「見ているだけです」。",
        "zh-Hans": "「お探し」是在找东西，「お声がけください」是需要的话叫他。只是看看就说「見ているだけです」。",
        "en": "お探し means looking for something, and お声がけください means call them if you need help. Say 見ているだけです if you are just looking."
      },
      "wordIds": [
        "sales-clerk"
      ]
    },
    {
