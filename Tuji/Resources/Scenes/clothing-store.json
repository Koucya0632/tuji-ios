      "response": {
        "ja": "三点です",
        "audio": "clothing-store.item-count.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "進試衣間前店員會先數件數。「何点」是幾件，「ご試着」是試穿。回「三点です」，或直接比手指。",
        "zh-Hans": "进试衣间前店员会先数件数。「何点」是几件，「ご試着」是试穿。回「三点です」，或者直接比手指。",
        "en": "Staff count your items before the fitting room. 何点 asks how many, and ご試着 means trying on. Answer 三点です, or show it with your fingers."
      },
      "wordIds": [
        "hanger"
      ]
    },
