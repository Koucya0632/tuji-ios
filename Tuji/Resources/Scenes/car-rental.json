      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台確認還車時間",
        "zh-Hans": "听懂柜台确认还车时间",
        "en": "Understand when the counter checks your return time"
      },
      "phrasings": [
        {
          "id": "car-rental.return-time.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ご返却は三日の午後五時でよろしいですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "car-rental.return-time.p1.mp3"
        },
        {
          "id": "car-rental.return-time.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "返却時間はお間違いないですか？",
          "voice": "Charon",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "car-rental.return-time.p2.mp3"
        },
        {
          "id": "car-rental.return-time.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お戻りは何時ごろのご予定ですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "car-rental.return-time.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "確認還車時間",
            "zh-Hans": "确认还车时间",
            "en": "Confirming when you return the car"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要在哪家店還車",
            "zh-Hans": "要在哪家店还车",
            "en": "Which branch you return it to"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "什麼時候要出發",
            "zh-Hans": "什么时候出发",
            "en": "When you are setting off"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "はい、大丈夫です",
        "audio": "car-rental.return-time.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「返却」「お戻り」是還車。「三日」是三號，不是三天。時間對就說「はい、大丈夫です」。",
        "zh-Hans": "「返却」「お戻り」是还车。「三日」是三号，不是三天。时间对就说「はい、大丈夫です」。",
        "en": "返却 and お戻り mean returning the car. 三日 here is the 3rd of the month, not three days. If the time is right, say はい、大丈夫です."
      },
      "wordIds": []
    }
  ],
  "stage": {
