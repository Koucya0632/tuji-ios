      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂窗口請你填寄件單",
        "zh-Hans": "听懂窗口请你填寄件单",
        "en": "Understand when you are asked to fill in the label"
      },
      "phrasings": [
        {
          "id": "post-office.label.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "こちらのラベルにご記入をお願いします",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "post-office.label.p1.mp3"
        },
        {
          "id": "post-office.label.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "お届け先と中身を、こちらにお願いします",
