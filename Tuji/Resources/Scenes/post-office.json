          "audio": "post-office.payment.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要收據",
            "zh-Hans": "要不要收据",
            "en": "Do you need a receipt"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "運費是多少",
            "zh-Hans": "运费是多少",
            "en": "How much the postage is"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要用什麼付款",
            "zh-Hans": "要用什么付款",
            "en": "How you will pay"
          },
          "correct": true
        }
      ],
      "response": {
        "ja": "カードで／現金で",
        "audio": "post-office.payment.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「お支払い」是付款。刷卡說「カードで」，付現說「現金で」。能用的付款方式依郵局不同。",
        "zh-Hans": "「お支払い」是付款。刷卡说「カードで」，付现说「現金で」。能用的付款方式依邮局不同。",
        "en": "お支払い means payment. Say カードで for card or 現金で for cash. Which methods are accepted depends on the post office."
      },
      "wordIds": []
    }
  ],
