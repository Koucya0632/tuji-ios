        },
        {
          "id": "post-office.label.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "伝票のご記入をお願いできますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "post-office.label.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "請把包裹放到秤上",
            "zh-Hans": "请把包裹放到秤上",
            "en": "Please put the parcel on the scale"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "請填寫這張單",
            "zh-Hans": "请填写这张单",
            "en": "Please fill in this form"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "請到旁邊的窗口",
            "zh-Hans": "请到旁边的窗口",
            "en": "Please go to the next counter"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "はい",
        "audio": "post-office.label.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「ラベル」「伝票」是寄件單，要寫收件人、地址和內容物。填寫方式依郵局與目的地不同，以現場說明為準。",
        "zh-Hans": "「ラベル」「伝票」是寄件单，要写收件人、地址和内容物。填写方式依邮局与目的地不同，以现场说明为准。",
        "en": "ラベル and 伝票 are the shipping form. It asks for the recipient, the address and the contents. How it is done depends on the post office and the destination, so follow what the staff tell you."
      },
      "wordIds": [
        "shipping-label"
      ],
      "reviewNote": "Whether international labels must now be prepared online beforehand (国際郵便マイページ) is unconfirmed in the outline; check before release."
    },
    {
