            "zh-Hant": "運費是多少",
            "zh-Hans": "运费是多少",
            "en": "How much the postage is"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要用什麼付款",
            "zh-Hans": "要用什么付款",
            "en": "How you will pay"
          },
          "correct": true
        }
      ],
      "response": {
