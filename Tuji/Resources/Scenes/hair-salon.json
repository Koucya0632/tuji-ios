  "questions": [
    {
      "id": "hair-salon.name",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問預約的名字",
        "zh-Hans": "听懂店员问预约的名字",
        "en": "Understand when you are asked the name on the booking"
      },
      "phrasings": [
        {
          "id": "hair-salon.name.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ご予約のお名前をお願いします",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.name.p1.mp3"
        },
        {
          "id": "hair-salon.name.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "お名前お伺いしてもよろしいですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "hair-salon.name.p2.mp3"
        },
        {
          "id": "hair-salon.name.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "ご予約のお名前を伺ってもよろしいでしょうか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.name.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "請問預約的名字",
            "zh-Hans": "请问预约的名字",
            "en": "What name is the booking under"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "今天想怎麼弄",
            "zh-Hans": "今天想怎么弄",
            "en": "What would you like today"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "有沒有指定設計師",
            "zh-Hans": "有没有指定发型师",
            "en": "Do you have a stylist in mind"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "ワンです",
        "audio": "hair-salon.name.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「ご予約のお名前」是預約時用的名字。說名字加「です」，也可以給他看預約畫面。",
        "zh-Hans": "「ご予約のお名前」是预约时用的名字。说名字加「です」，也可以给他看预约页面。",
        "en": "ご予約のお名前 is the name on your booking. Say it with です, or show the booking on your phone."
      },
      "wordIds": [
        "hair-salon"
      ]
    },
    {
      "id": "hair-salon.menu",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂設計師問今天要做什麼",
        "zh-Hans": "听懂发型师问今天要做什么",
        "en": "Understand when the stylist asks what you want today"
      },
      "phrasings": [
        {
          "id": "hair-salon.menu.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "本日はどうされますか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.menu.p1.mp3"
        },
        {
          "id": "hair-salon.menu.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "今日はどんな感じにしますか？",
          "voice": "Kore",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "hair-salon.menu.p2.mp3"
        },
        {
          "id": "hair-salon.menu.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "本日はカットのみでよろしいですか？",
          "voice": "Puck",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.menu.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要洗頭",
            "zh-Hans": "要不要洗头",
            "en": "Do you want a shampoo"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "今天想怎麼弄",
            "zh-Hans": "今天想怎么弄",
            "en": "What would you like today"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要剪多短",
            "zh-Hans": "要剪多短",
            "en": "How short to cut"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "カットだけでお願いします",
        "audio": "hair-salon.menu.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「カット」是剪髮，「のみ」是只有。只剪就說「カットだけでお願いします」。想要的髮型最好給他看照片，說「こんな感じで」。",
        "zh-Hans": "「カット」是剪发，「のみ」是只有。只剪就说「カットだけでお願いします」。想要的发型最好给他看照片，说「こんな感じで」。",
        "en": "カット is a haircut and のみ means only. Say カットだけでお願いします for just a cut. For the style, showing a photo and saying こんな感じで works best."
      },
      "wordIds": [
        "haircut",
        "mobile-phone"
      ]
    },
    {
      "id": "hair-salon.length",
      "kind": "listening",
      "goal": {
