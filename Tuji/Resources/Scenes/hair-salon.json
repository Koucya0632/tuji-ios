  "stage": {
    "routes": [
      {
        "id": "main",
        "title": {
          "zh-Hant": "剪短一點",
          "zh-Hans": "剪短一点",
          "en": "A little shorter"
        },
        "intent": {
          "zh-Hant": "你用ワン這個名字預約了剪髮，只剪不染。想剪 3 公分左右，瀏海不動，稍微打薄。",
          "zh-Hans": "你用ワン这个名字预约了剪发，只剪不染。想剪 3 厘米左右，刘海不动，稍微打薄。",
          "en": "You booked a haircut under the name ワン, cut only. You want about 3 cm off, the fringe left alone, and a little thinning."
