        },
        {
          "id": "hair-salon.bangs.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "前髪の長さはどのくらいにしますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.bangs.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "後面要剪多短",
            "zh-Hans": "后面要剪多短",
            "en": "How short at the back"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要不要打薄",
            "zh-Hans": "要不要打薄",
            "en": "Do you want it thinned"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "瀏海要怎麼弄",
            "zh-Hans": "刘海要怎么弄",
            "en": "What to do with your fringe"
          },
          "correct": true
        }
      ],
      "response": {
        "ja": "そのままで／眉くらいで",
        "audio": "hair-salon.bangs.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「前髪」是瀏海。不剪說「そのままで」，要剪到眉毛說「眉くらいで」。",
        "zh-Hans": "「前髪」是刘海。不剪说「そのままで」，要剪到眉毛说「眉くらいで」。",
        "en": "前髪 is your fringe. Say そのままで to leave it, or 眉くらいで to cut it to your eyebrows."
      },
      "wordIds": [
        "bangs"
      ]
    },
    {
      "id": "hair-salon.thinning",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂設計師問要不要打薄",
        "zh-Hans": "听懂发型师问要不要打薄",
        "en": "Understand when the stylist asks about thinning your hair"
      },
      "phrasings": [
        {
          "id": "hair-salon.thinning.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "量はすきますか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.thinning.p1.mp3"
        },
        {
          "id": "hair-salon.thinning.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "毛量、少し軽くしますか？",
          "voice": "Kore",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "hair-salon.thinning.p2.mp3"
        },
        {
          "id": "hair-salon.thinning.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "量は減らしても大丈夫ですか？",
          "voice": "Puck",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.thinning.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要剪短一點",
            "zh-Hans": "要不要剪短一点",
            "en": "Do you want it shorter"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要不要打薄",
            "zh-Hans": "要不要打薄",
            "en": "Do you want it thinned"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要抹造型品",
            "zh-Hans": "要不要抹造型产品",
            "en": "Do you want styling product"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "少しお願いします／そのままで",
        "audio": "hair-salon.thinning.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「量」「毛量」是頭髮的量，「すく」「軽くする」「減らす」都是打薄。要就說「少しお願いします」，不要說「そのままで」。",
        "zh-Hans": "「量」「毛量」是头发的量，「すく」「軽くする」「減らす」都是打薄。要就说「少しお願いします」，不要说「そのままで」。",
        "en": "量 and 毛量 mean how much hair, and すく, 軽くする and 減らす all mean thinning it out. Say 少しお願いします for a little, or そのままで to leave it."
      },
      "wordIds": [
        "thinning-scissors"
      ],
      "reviewNote": "Hair terms (すく, 毛量を軽くする) should be checked by a hairdresser."
    },
    {
      "id": "hair-salon.water-temperature",
      "kind": "listening",
      "goal": {
        "zh-Hant": "洗頭時聽懂設計師問水溫可以嗎",
        "zh-Hans": "洗头时听懂发型师问水温可以吗",
        "en": "Understand when you are asked about the water temperature during the shampoo"
      },
      "phrasings": [
        {
          "id": "hair-salon.water-temperature.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "お湯加減いかがですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.water-temperature.p1.mp3"
        },
        {
          "id": "hair-salon.water-temperature.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "熱くないですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "hair-salon.water-temperature.p2.mp3"
        },
        {
          "id": "hair-salon.water-temperature.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お湯の温度は大丈夫ですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hair-salon.water-temperature.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "水溫可以嗎",
            "zh-Hans": "水温可以吗",
            "en": "Is the water temperature OK"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "有沒有哪裡癢",
            "zh-Hans": "有没有哪里痒",
            "en": "Is anywhere itchy"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要按摩",
            "zh-Hans": "要不要按摩",
            "en": "Would you like a massage"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "大丈夫です",
        "audio": "hair-salon.water-temperature.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「お湯加減」是水溫，「熱くないですか」是問會不會太燙。沒問題說「大丈夫です」，太燙說「ちょっと熱いです」。洗頭時也常問「かゆいところはございませんか」，是問有沒有哪裡癢。",
        "zh-Hans": "「お湯加減」是水温，「熱くないですか」是问会不会太烫。没问题说「大丈夫です」，太烫说「ちょっと熱いです」。洗头时也常问「かゆいところはございませんか」，是问有没有哪里痒。",
        "en": "お湯加減 is the water temperature, and 熱くないですか asks if it is too hot. Say 大丈夫です if it is fine, or ちょっと熱いです if too hot. They also often ask かゆいところはございませんか, which means is anywhere itchy."
      },
      "wordIds": [
        "shampoo-basin"
      ]
    },
