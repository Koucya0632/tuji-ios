        {
          "id": "ramen-shop.counter-seat.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "カウンターでもよろしいですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "ramen-shop.counter-seat.p2.mp3"
        },
        {
          "id": "ramen-shop.counter-seat.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お席、カウンターになりますが大丈夫ですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ramen-shop.counter-seat.p3.mp3"
