      "phrasings": [
        {
          "id": "ramen-shop.counter-seat.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "食券お預かりします。カウンター席でよろしいですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ramen-shop.counter-seat.p1.mp3"
        },
        {
          "id": "ramen-shop.counter-seat.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "カウンターでもよろしいですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "ramen-shop.counter-seat.p2.mp3"
        },
        {
          "id": "ramen-shop.counter-seat.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お席、カウンターになりますが大丈夫ですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ramen-shop.counter-seat.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "坐吧檯可以嗎",
            "zh-Hans": "坐吧台可以吗",
            "en": "Is the counter all right"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要不要等桌子的位子",
            "zh-Hans": "要不要等桌子的位子",
            "en": "Do you want to wait for a table"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要先買券嗎",
            "zh-Hans": "要先买券吗",
            "en": "Do you need to buy a ticket first"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "はい、大丈夫です",
        "audio": "ramen-shop.counter-seat.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「カウンター」是吧檯座位。「食券お預かりします」是店員收下你的券。可以的話說「はい、大丈夫です」。",
        "zh-Hans": "「カウンター」是吧台座位。「食券お預かりします」是店员收下你的券。可以的话说「はい、大丈夫です」。",
        "en": "カウンター is the counter seating. 食券お預かりします just means the staff are taking your ticket. Say はい、大丈夫です if that is fine."
      },
      "wordIds": [
        "counter-seat"
      ]
    },
