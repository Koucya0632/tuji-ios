    {
      "id": "ramen-shop.counter-seat",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問坐吧檯可不可以",
        "zh-Hans": "听懂店员问坐吧台行不行",
        "en": "Understand when the staff ask if the counter is fine"
