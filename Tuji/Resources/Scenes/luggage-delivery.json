{
  "schemaVersion": 2,
  "id": "luggage-delivery",
  "revision": 1,
  "access": "lifetime",
  "title": {
    "zh-Hant": "寄送行李到機場",
    "zh-Hans": "寄送行李到机场",
    "en": "Sending luggage to the airport"
  },
  "summary": {
    "zh-Hant": "寄行李到機場時櫃台會問的六件事",
    "zh-Hans": "寄行李到机场时柜台会问的六件事",
    "en": "Six things the counter asks when you send bags to the airport"
  },
  "questions": [
    {
      "id": "luggage-delivery.count",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台問要寄幾件",
        "zh-Hans": "听懂柜台问要寄几件",
        "en": "Understand when you are asked how many bags to send"
      },
      "phrasings": [
        {
          "id": "luggage-delivery.count.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "お荷物は何個お送りしますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "luggage-delivery.count.p1.mp3"
        },
        {
          "id": "luggage-delivery.count.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "何個口ですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "luggage-delivery.count.p2.mp3"
        },
        {
          "id": "luggage-delivery.count.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お送りするのは全部で何点ですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "luggage-delivery.count.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要寄到哪裡",
            "zh-Hans": "要寄到哪里",
            "en": "Where to send them"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要寄幾件",
            "zh-Hans": "要寄几件",
            "en": "How many bags to send"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "行李有多重",
            "zh-Hans": "行李有多重",
            "en": "How heavy the bags are"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "2つです",
        "audio": "luggage-delivery.count.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「何個」「何点」都是問幾件，「個口」是宅配算件數的說法。說「2つです」，或用手指比。",
        "zh-Hans": "「何個」「何点」都是问几件，「個口」是快递算件数的说法。说「2つです」，或用手指比。",
        "en": "何個 and 何点 both ask how many. 個口 is the word couriers use to count parcels. Say 2つです, or show it with your fingers."
      },
      "wordIds": [
        "suitcase"
      ]
    },
    {
      "id": "luggage-delivery.contents",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台問有沒有貴重品或易碎物",
        "zh-Hans": "听懂柜台问有没有贵重品或易碎物",
        "en": "Understand when you are asked about valuables or fragile items"
      },
      "phrasings": [
        {
          "id": "luggage-delivery.contents.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "貴重品や割れ物は入っていませんか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "luggage-delivery.contents.p1.mp3"
        },
        {
          "id": "luggage-delivery.contents.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "壊れ物や貴重品、入っていませんよね？",
          "voice": "Charon",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "luggage-delivery.contents.p2.mp3"
        },
        {
          "id": "luggage-delivery.contents.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "パソコンや現金、割れ物などは入っていませんか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "luggage-delivery.contents.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "有沒有貴重品或易碎物",
            "zh-Hans": "有没有贵重品或易碎物",
            "en": "Any valuables or fragile items"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "行李有沒有上鎖",
            "zh-Hans": "行李有没有上锁",
            "en": "Is your bag locked"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "裡面裝了什麼衣服",
            "zh-Hans": "里面装了什么衣服",
            "en": "What clothes are inside"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "入っていません",
        "audio": "luggage-delivery.contents.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「貴重品」是現金、電腦這類東西，「割れ物」「壊れ物」是易碎物。這是否定問句，回「はい」是「對，沒有」，直接說「入っていません」。電池、噴霧罐等也可能不能寄，依業者規定不同，以現場說明為準。",
        "zh-Hans": "「貴重品」是现金、电脑这类东西，「割れ物」「壊れ物」是易碎物。这是否定问句，回「はい」是「对，没有」，直接说「入っていません」。电池、喷雾罐等也可能不能寄，依快递公司规定不同，以现场说明为准。",
        "en": "貴重品 means valuables like cash or a laptop, and 割れ物 or 壊れ物 means fragile items. This is a negative question, so はい means yes, there are none. Say 入っていません. Batteries and sprays may not be accepted either; rules differ by company, so follow what the staff tell you."
      },
      "wordIds": [],
      "reviewNote": "Courier rules on valuables, batteries and sprays for airport delivery differ by company; check the explanation with someone who knows current practice."
    },
    {
      "id": "luggage-delivery.airport",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台問要寄到哪個機場",
