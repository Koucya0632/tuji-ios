          "id": "a",
          "text": {
            "zh-Hant": "哪天出發",
            "zh-Hans": "哪天出发",
            "en": "Which day you leave"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "飛機幾點起飛",
            "zh-Hans": "飞机几点起飞",
            "en": "What time your flight leaves"
          },
          "correct": false
        },
        {
