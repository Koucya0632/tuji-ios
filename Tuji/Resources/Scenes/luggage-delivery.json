      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要從哪個航廈出發",
            "zh-Hans": "要从哪个航站楼出发",
            "en": "Which terminal you leave from"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "哪天出發",
            "zh-Hans": "哪天出发",
            "en": "Which day you leave"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要寄到哪個機場",
            "zh-Hans": "要寄到哪个机场",
            "en": "Which airport to send it to"
          },
          "correct": true
        }
      ],
      "response": {
        "ja": "成田です",
        "audio": "luggage-delivery.airport.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「空港」是機場，「ご出発」是出發。說機場名加「です」，例如「成田です」「羽田です」「関空です」。寄到飯店的話，這裡會改問飯店名稱。",
        "zh-Hans": "「空港」是机场，「ご出発」是出发。说机场名加「です」，例如「成田です」「羽田です」「関空です」。寄到酒店的话，这里会改问酒店名称。",
        "en": "空港 is airport and ご出発 is departure. Say the airport name with です, like 成田です, 羽田です or 関空です. If you are sending to a hotel, they ask for the hotel name here instead."
      },
      "wordIds": [
        "airport-terminal"
      ]
    },
    {
