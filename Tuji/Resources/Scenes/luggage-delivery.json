  "stage": {
    "routes": [
      {
        "id": "main",
        "title": {
          "zh-Hant": "行李寄到成田",
          "zh-Hans": "行李寄到成田",
          "en": "Bags to Narita"
        },
        "intent": {
          "zh-Hant": "你是ワン，想從飯店把兩件行李寄到成田機場，15 日搭機。行李裡沒有貴重品或易碎物，航班在手機的電子機票上。",
          "zh-Hans": "你是ワン，想从酒店把两件行李寄到成田机场，15 日坐飞机。行李里没有贵重物品或易碎品，航班在手机的电子机票上。",
          "en": "You're ワン (Wang) and want to send two bags from the hotel to Narita Airport for your flight on the 15th. Nothing valuable or fragile is inside, and your flight is on the e-ticket on your phone."
        },
        "enter": {
          "zh-Hant": "走到櫃台",
          "zh-Hans": "走到前台",
          "en": "Walk up to the desk"
        },
        "questions": [
