  "questions": [
    {
      "id": "airport-check-in.passport",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂地勤請你出示護照",
        "zh-Hans": "听懂地勤请你出示护照",
        "en": "Understand when the agent asks for your passport"
      },
      "phrasings": [
        {
          "id": "airport-check-in.passport.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "パスポートをお願いします。",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "airport-check-in.passport.p1.mp3"
        },
        {
          "id": "airport-check-in.passport.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "パスポートを拝見してもよろしいですか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "airport-check-in.passport.p2.mp3"
        },
        {
          "id": "airport-check-in.passport.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "パスポートとご予約の控えをお願いします。",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "airport-check-in.passport.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "請出示護照",
            "zh-Hans": "请出示护照",
            "en": "Your passport, please"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "請出示登機證",
            "zh-Hans": "请出示登机牌",
            "en": "Your boarding pass, please"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "請把行李放上來",
            "zh-Hans": "请把行李放上来",
            "en": "Please put your bag up here"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "はい、お願いします",
        "audio": "airport-check-in.passport.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「パスポート」是護照，「拝見」是看一下。「ご予約の控え」是訂位確認，可以給地勤看手機畫面。",
        "zh-Hans": "「パスポート」是护照，「拝見」是看一下。「ご予約の控え」是订票确认，可以给地勤看手机画面。",
        "en": "パスポート is your passport and 拝見 means to take a look. ご予約の控え is your booking confirmation, and showing it on your phone is fine."
      },
      "wordIds": [
        "passport",
        "check-in-counter"
      ]
    },
    {
      "id": "airport-check-in.checked-bags",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂地勤問有沒有要託運的行李",
        "zh-Hans": "听懂地勤问有没有要托运的行李",
        "en": "Understand when the agent asks about bags to check in"
      },
      "phrasings": [
        {
          "id": "airport-check-in.checked-bags.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "お預けになるお荷物はございますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "airport-check-in.checked-bags.p1.mp3"
        },
        {
          "id": "airport-check-in.checked-bags.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "お預けのお荷物は何個ですか？",
          "voice": "Charon",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "airport-check-in.checked-bags.p2.mp3"
        },
        {
          "id": "airport-check-in.checked-bags.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お荷物はお預けになりますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "airport-check-in.checked-bags.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "有沒有要託運的行李",
            "zh-Hans": "有没有要托运的行李",
            "en": "Any bags to check in"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "有沒有要帶上飛機的行李",
            "zh-Hans": "有没有要带上飞机的行李",
            "en": "Any bags to take on board"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "行李要不要包起來",
            "zh-Hans": "行李要不要包起来",
            "en": "Shall we wrap your bag"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "一つです／ありません",
        "audio": "airport-check-in.checked-bags.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「預ける」是託運，「お荷物」是行李。要託運就說件數，例如「一つです」；沒有就說「ありません」。",
        "zh-Hans": "「預ける」是托运，「お荷物」是行李。要托运就说件数，比如「一つです」；没有就说「ありません」。",
        "en": "預ける means to check a bag in, and お荷物 is luggage. Say how many, like 一つです, or ありません if you have none."
      },
      "wordIds": [
        "suitcase",
        "self-service-bag-drop"
      ]
    },
    {
      "id": "airport-check-in.dangerous-goods",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂地勤問託運行李裡有沒有行動電源或打火機",
        "zh-Hans": "听懂地勤问托运行李里有没有充电宝或打火机",
        "en": "Understand when the agent asks if your checked bag holds power banks or lighters"
      },
      "reviewNote": "航空危險物品：行動電源、鋰電池、打火機、噴霧罐的託運與攜帶規定由國土交通省與各航空公司公告，近年持續收緊。解說不列規則，只寫依規定不同；需航空業審稿，並決定要不要連到官方公告。",
      "phrasings": [
        {
          "id": "airport-check-in.dangerous-goods.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "お荷物の中に、モバイルバッテリーやライターは入っていませんか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "airport-check-in.dangerous-goods.p1.mp3"
        },
        {
          "id": "airport-check-in.dangerous-goods.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "リチウム電池やスプレー缶などは入っておりませんか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "airport-check-in.dangerous-goods.p2.mp3"
        },
        {
          "id": "airport-check-in.dangerous-goods.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "預けるお荷物に、モバイルバッテリーは入っていませんか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "airport-check-in.dangerous-goods.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "行李裡有沒有行動電源或打火機",
            "zh-Hans": "行李里有没有充电宝或打火机",
            "en": "Are there power banks or lighters in your bag"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "行李裡有沒有易碎品",
            "zh-Hans": "行李里有没有易碎品",
            "en": "Is there anything fragile in your bag"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "行李有沒有超重",
            "zh-Hans": "行李有没有超重",
            "en": "Is your bag over the weight limit"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "入っていません／入っています",
        "audio": "airport-check-in.dangerous-goods.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「入っていませんか」是否定問句，回「はい」是「對，沒有放」，很容易答反。直接說「入っていません」（沒有）或「入っています」（有）。哪些東西能託運、能帶上飛機，依航空公司和規定不同，以現場說明和官方公告為準。有的話照地勤的指示處理。",
        "zh-Hans": "「入っていませんか」是否定问句，回「はい」是「对，没有放」，很容易答反。直接说「入っていません」（没有）或「入っています」（有）。哪些东西能托运、能带上飞机，依航空公司和规定不同，以现场说明和官方公告为准。有的话照地勤的指示处理。",
        "en": "入っていませんか is a negative question, so はい means \"right, there aren't any\". It is easy to get backwards. Say 入っていません (there aren't) or 入っています (there are). What may be checked or carried on depends on the airline and the rules, so follow the agent and the official notices."
      },
      "wordIds": [
        "power-bank"
      ]
    },
    {
      "id": "airport-check-in.fragile",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂地勤問有沒有易碎品或貴重物品",
        "zh-Hans": "听懂地勤问有没有易碎品或贵重物品",
        "en": "Understand when the agent asks about fragile items or valuables"
      },
      "phrasings": [
        {
          "id": "airport-check-in.fragile.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "壊れ物や貴重品は入っていませんか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
