  "stage": {
    "routes": [
      {
        "id": "main",
        "title": {
          "zh-Hant": "搭機回台北",
          "zh-Hans": "搭机回台北",
          "en": "Flying home to Taipei"
        },
        "intent": {
          "zh-Hant": "你要搭飛機回台北。有一件行李箱要託運，裡面沒有行動電源、打火機，也沒有易碎品。想坐靠窗。",
          "zh-Hans": "你要坐飞机回台北。有一个行李箱要托运，里面没有充电宝、打火机，也没有易碎品。想坐靠窗。",
          "en": "You're flying home to Taipei. You have one suitcase to check, with no power bank, lighter or anything fragile in it. You'd like a window seat."
        },
        "enter": {
          "zh-Hant": "走到報到櫃台",
          "zh-Hans": "走到值机柜台",
          "en": "Walk up to the check-in counter"
        },
        "questions": [
          "airport-check-in.passport",
          "airport-check-in.checked-bags",
          "airport-check-in.dangerous-goods",
          "airport-check-in.fragile",
          "airport-check-in.seat",
          "airport-check-in.gate"
        ]
      }
    ],
