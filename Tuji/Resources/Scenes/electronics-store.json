  "questions": [
    {
      "id": "electronics-store.point-card",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問有沒有集點卡",
        "zh-Hans": "听懂店员问有没有积分卡",
        "en": "Understand when the clerk asks for a points card"
      },
      "phrasings": [
        {
          "id": "electronics-store.point-card.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ポイントカードはお持ちですか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "electronics-store.point-card.p1.mp3"
        },
        {
          "id": "electronics-store.point-card.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "当店のポイントカードはございますか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "electronics-store.point-card.p2.mp3"
        },
        {
          "id": "electronics-store.point-card.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "ポイントカードのご提示はございますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "electronics-store.point-card.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "有沒有集點卡",
            "zh-Hans": "有没有积分卡",
            "en": "Do you have a points card"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要不要辦一張集點卡",
            "zh-Hans": "要不要办一张积分卡",
            "en": "Would you like to get a points card"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要辦免稅",
            "zh-Hans": "要不要办免税",
            "en": "Do you want tax-free"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "持っていません",
        "audio": "electronics-store.point-card.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「お持ちですか」「ございますか」是問你有沒有。沒有就說「持っていません」。如果問「お作りしましょうか」，是要幫你辦新卡，不用就說「大丈夫です」。",
        "zh-Hans": "「お持ちですか」「ございますか」是问你有没有。没有就说「持っていません」。如果问「お作りしましょうか」，是要帮你办新卡，不用就说「大丈夫です」。",
        "en": "お持ちですか and ございますか ask if you have one. Say 持っていません if not. If you hear お作りしましょうか, they are offering to make you a new card; say 大丈夫です to decline."
      },
      "wordIds": [
        "point-card"
      ]
    },
    {
      "id": "electronics-store.tax-free",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問要不要辦免稅",
        "zh-Hans": "听懂店员问要不要办免税",
        "en": "Understand when the clerk asks if you want tax-free"
      },
      "phrasings": [
        {
          "id": "electronics-store.tax-free.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "免税のお手続きはされますか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "electronics-store.tax-free.p1.mp3"
        },
        {
          "id": "electronics-store.tax-free.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "パスポートはお持ちですか？",
          "voice": "Aoede",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "electronics-store.tax-free.p2.mp3"
        },
        {
          "id": "electronics-store.tax-free.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "海外のお客様でしょうか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "electronics-store.tax-free.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "是不是要在國外用",
            "zh-Hans": "是不是要在国外用",
            "en": "Will you use it abroad"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要不要辦免稅",
            "zh-Hans": "要不要办免税",
            "en": "Do you want tax-free"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "有沒有集點卡",
            "zh-Hans": "有没有积分卡",
            "en": "Do you have a points card"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "お願いします",
        "audio": "electronics-store.tax-free.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「免税のお手続き」是辦免稅。問「パスポート」或「海外のお客様」，也是在確認你能不能辦。2026 年 11 月起改成先付含稅價，出境時經海關確認後再退稅。細節依店家／規定不同，以現場說明為準。",
        "zh-Hans": "「免税のお手続き」是办免税。问「パスポート」或「海外のお客様」，也是在确认你能不能办。2026 年 11 月起改成先付含税价，出境时经海关确认后再退税。细节依店家／规定不同，以现场说明为准。",
        "en": "免税のお手続き means the tax-free procedure. Being asked for your パスポート or whether you are a 海外のお客様 is the same check. From November 2026 you pay the price with tax and get the tax back after customs checks your goods as you leave Japan. Details differ by store and by the rules, so follow what the staff tell you."
      },
      "wordIds": [
        "passport"
      ],
      "reviewNote": "2026-11 リファンド方式：家電量販店收銀台的免稅問法與流程描述要核對；「海外のお客様でしょうか」是否常用待確認。"
    },
    {
      "id": "electronics-store.overseas-use",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員提醒這是日本國內專用",
        "zh-Hans": "听懂店员提醒这是日本国内专用",
        "en": "Understand the warning that an item is for use in Japan only"
      },
      "phrasings": [
        {
          "id": "electronics-store.overseas-use.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "こちら日本国内専用ですが、よろしいですか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "electronics-store.overseas-use.p1.mp3"
