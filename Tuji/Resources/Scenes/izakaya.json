          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "有沒有訂位",
            "zh-Hans": "有没有订位",
            "en": "Do you have a booking"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要喝到飽",
            "zh-Hans": "要不要无限畅饮",
            "en": "Do you want all-you-can-drink"
