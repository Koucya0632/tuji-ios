  "questions": [
    {
      "id": "taxi.luggage",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂司機問行李要不要放後車廂",
        "zh-Hans": "听懂司机问行李要不要放后备箱",
        "en": "Understand when the driver offers to put your luggage in the trunk"
      },
      "phrasings": [
        {
          "id": "taxi.luggage.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "お荷物はトランクにお入れしますか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "taxi.luggage.p1.mp3"
        },
        {
          "id": "taxi.luggage.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "トランク開けますね、お荷物入れましょうか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "taxi.luggage.p2.mp3"
        },
        {
          "id": "taxi.luggage.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "スーツケースは後ろに積みましょうか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "taxi.luggage.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "行李要放後車廂嗎",
            "zh-Hans": "行李要放后备箱吗",
            "en": "Shall I put your bags in the trunk"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "總共幾個人",
            "zh-Hans": "一共几个人",
            "en": "How many of you are there"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要去哪裡",
            "zh-Hans": "去哪里",
            "en": "Where to"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "お願いします／大丈夫です",
        "audio": "taxi.luggage.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「トランク」是後車廂，「お荷物」是行李。要放就說「お願いします」，自己拿著就說「大丈夫です」。",
        "zh-Hans": "「トランク」是后备箱，「お荷物」是行李。要放就说「お願いします」，自己拿着就说「大丈夫です」。",
        "en": "トランク is the trunk and お荷物 is your luggage. Say お願いします for yes, or 大丈夫です if you will keep it with you."
      },
      "wordIds": [
        "suitcase"
      ]
    },
    {
      "id": "taxi.destination",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂司機問要去哪裡",
        "zh-Hans": "听懂司机问去哪里",
        "en": "Understand when the driver asks where you are going"
      },
      "phrasings": [
        {
          "id": "taxi.destination.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "どちらまでですか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "taxi.destination.p1.mp3"
        },
        {
          "id": "taxi.destination.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "どちらまで行かれますか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "taxi.destination.p2.mp3"
        },
        {
          "id": "taxi.destination.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "行き先はどちらでしょうか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "taxi.destination.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要去哪裡",
            "zh-Hans": "去哪里",
            "en": "Where to"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "從哪裡來的",
            "zh-Hans": "从哪里来的",
            "en": "Where are you from"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要走哪條路",
            "zh-Hans": "走哪条路",
            "en": "Which way should I take"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "ここまでお願いします",
        "audio": "taxi.destination.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「どちらまで」是問到哪裡，不是「どちらから」（從哪裡來）。給司機看手機地圖或寫好的地址，說「ここまでお願いします」。用叫車 App 先設好目的地的話，司機通常不會再問。",
        "zh-Hans": "「どちらまで」是问到哪里，不是「どちらから」（从哪里来）。给司机看手机地图或写好的地址，说「ここまでお願いします」。用打车 App 先设好目的地的话，司机通常不会再问。",
        "en": "どちらまで asks where to, not どちらから (where from). Show a map or a written address and say ここまでお願いします. If you booked through a taxi app, the driver usually already knows."
      },
      "wordIds": [
        "taxi",
        "taxi-stand"
      ]
    },
    {
