      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "請繫安全帶",
            "zh-Hans": "请系安全带",
            "en": "Please fasten your seatbelt"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "請關好車門",
            "zh-Hans": "请关好车门",
            "en": "Please close the door"
