  "questions": [
    {
      "id": "ryokan.dinner-time",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂仲居問晚餐要幾點",
        "zh-Hans": "听懂仲居问晚餐要几点",
        "en": "Understand when you are asked what time to have dinner"
      },
      "phrasings": [
        {
          "id": "ryokan.dinner-time.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ご夕食は何時になさいますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ryokan.dinner-time.p1.mp3"
        },
        {
          "id": "ryokan.dinner-time.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "お夕食、6時と7時半、どちらがよろしいですか？",
          "voice": "Kore",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "ryokan.dinner-time.p2.mp3"
        },
        {
          "id": "ryokan.dinner-time.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "夕食のお時間はいかがいたしましょうか？",
          "voice": "Charon",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ryokan.dinner-time.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "晚餐要幾點吃",
            "zh-Hans": "晚餐要几点吃",
            "en": "What time for dinner"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "早餐要幾點吃",
            "zh-Hans": "早餐要几点吃",
            "en": "What time for breakfast"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "晚餐要在哪裡吃",
            "zh-Hans": "晚餐要在哪里吃",
            "en": "Where to have dinner"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "6時でお願いします",
        "audio": "ryokan.dinner-time.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「夕食」「お夕食」是晚餐。有時會給兩個時段讓你選，說「〇時でお願いします」。能選的時段依旅館不同。",
        "zh-Hans": "「夕食」「お夕食」是晚餐。有时会给两个时段让你选，说「〇時でお願いします」。能选的时段依旅馆不同。",
        "en": "夕食 is dinner. You may be offered two time slots. Answer with the time and でお願いします. The slots differ from ryokan to ryokan."
      },
      "wordIds": [
        "kaiseki-meal"
      ]
    },
    {
      "id": "ryokan.allergies",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂仲居問有沒有不能吃的東西",
        "zh-Hans": "听懂仲居问有没有不能吃的东西",
        "en": "Understand when you are asked about foods you cannot eat"
      },
      "phrasings": [
        {
          "id": "ryokan.allergies.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "苦手なものやアレルギーはございますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ryokan.allergies.p1.mp3"
        },
        {
          "id": "ryokan.allergies.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "召し上がれないものはございませんか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "ryokan.allergies.p2.mp3"
        },
        {
          "id": "ryokan.allergies.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "食物アレルギーなどはございますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "ryokan.allergies.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "有沒有特別想吃的東西",
            "zh-Hans": "有没有特别想吃的东西",
            "en": "Is there anything you would like to eat"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "有沒有不能吃或過敏的東西",
            "zh-Hans": "有没有不能吃或过敏的东西",
            "en": "Anything you cannot eat or are allergic to"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "晚餐要幾點吃",
            "zh-Hans": "晚餐要几点吃",
            "en": "What time for dinner"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "ありません／エビが食べられません",
        "audio": "ryokan.allergies.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「苦手なもの」是不喜歡或不能吃的東西，「アレルギー」是過敏。「召し上がれないものはございませんか」是否定問句，回「はい」可能被聽成「對，沒有」，所以直接說內容：沒有說「ありません」，有就說「〇〇が食べられません」。嚴重過敏請在訂房時就用文字告知，能不能對應依旅館不同，以現場說明為準。",
        "zh-Hans": "「苦手なもの」是不喜欢或不能吃的东西，「アレルギー」是过敏。「召し上がれないものはございませんか」是否定问句，回「はい」可能被听成「对，没有」，所以直接说内容：没有说「ありません」，有就说「〇〇が食べられません」。严重过敏请在订房时就用文字告知，能不能应对依旅馆不同，以现场说明为准。",
        "en": "苦手なもの means foods you dislike or cannot eat, and アレルギー is allergy. 召し上がれないものはございませんか is a negative question, so a bare はい can mean yes, there is nothing. Say what you mean: ありません for nothing, or name the food with が食べられません. For a serious allergy, tell the ryokan in writing when you book. What they can handle varies, so follow what the staff tell you."
      },
      "wordIds": [],
      "reviewNote": "Food allergy is a safety topic. The advice to tell the ryokan in writing at booking and the three-language wording need a domain reviewer."
    },
