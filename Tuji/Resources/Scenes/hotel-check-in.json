      },
      "phrasings": [
        {
          "id": "hotel-check-in.passport.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "パスポートを拝見してもよろしいですか？",
          "voice": "Aoede",
          "speed": "normal",
