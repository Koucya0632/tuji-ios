          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "請用這台機器付款",
            "zh-Hans": "请用这台机器付款",
            "en": "Please pay at this machine"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "請填寫這張卡",
            "zh-Hans": "请填写这张卡",
            "en": "Please fill in this card"
          },
          "correct": true
        },
        {
          "id": "d",
          "text": {
            "zh-Hant": "請給我看護照",
            "zh-Hans": "请给我看护照",
            "en": "May I see your passport"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "はい",
        "audio": "hotel-check-in.registration-card.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「ご記入」是填寫，「宿泊カード」是住宿登記卡，通常要寫名字、地址、電話。填完交回櫃台。",
        "zh-Hans": "「ご記入」是填写，「宿泊カード」是入住登记卡，通常要写名字、地址、电话。填完交回前台。",
        "en": "ご記入 means to fill in, and 宿泊カード is the registration card. It usually asks for your name, address and phone number. Hand it back when you are done."
      },
      "wordIds": [
        "ballpoint-pen"
      ]
    },
