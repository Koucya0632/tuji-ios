  },
  "summary": {
    "zh-Hant": "入住時櫃台會問的六件事",
    "zh-Hans": "入住时前台会问的六件事",
    "en": "Six things the front desk asks at check-in"
  },
  "questions": [
    {
      "id": "hotel-check-in.name",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台問預約的名字",
        "zh-Hans": "听懂前台问预约的名字",
        "en": "Understand when the front desk asks the name on the booking"
      },
      "phrasings": [
        {
          "id": "hotel-check-in.name.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ご予約のお名前をお伺いできますか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hotel-check-in.name.p1.mp3"
        },
        {
          "id": "hotel-check-in.name.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "お名前頂戴してもよろしいでしょうか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "hotel-check-in.name.p2.mp3"
        },
        {
          "id": "hotel-check-in.name.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "ご予約者様のお名前をお願いします",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hotel-check-in.name.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "請問預約的名字",
            "zh-Hans": "请问预约的名字",
            "en": "What name is the booking under"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "請問你的電話號碼",
            "zh-Hans": "请问你的电话号码",
            "en": "What is your phone number"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "請給我看護照",
            "zh-Hans": "请给我看护照",
            "en": "May I see your passport"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "ワンです",
        "audio": "hotel-check-in.name.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「お名前」是名字，「ご予約者様」是訂房的人。說訂房時用的名字加「です」，也可以直接給他看預約畫面。",
        "zh-Hans": "「お名前」是名字，「ご予約者様」是订房的人。说订房时用的名字加「です」，也可以直接给他看预订页面。",
        "en": "お名前 means your name and ご予約者様 is the person who booked. Say the booking name with です, or show the booking on your phone."
      },
      "wordIds": [
        "hotel-receptionist"
      ]
    },
    {
      "id": "hotel-check-in.nights",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台在確認你住幾晚",
        "zh-Hans": "听懂前台在确认你住几晚",
        "en": "Understand the front desk confirming how many nights you stay"
      },
      "phrasings": [
        {
          "id": "hotel-check-in.nights.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "本日から2泊でお間違いないでしょうか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hotel-check-in.nights.p1.mp3"
        },
        {
          "id": "hotel-check-in.nights.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "2泊のご予約ですね",
          "voice": "Charon",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "hotel-check-in.nights.p2.mp3"
        },
        {
          "id": "hotel-check-in.nights.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "シングルのお部屋で2泊、承っております",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "hotel-check-in.nights.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "住一晚，對嗎",
            "zh-Hans": "住一晚，对吗",
            "en": "One night, right"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "住兩晚，對嗎",
            "zh-Hans": "住两晚，对吗",
            "en": "Two nights, right"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "住三晚，對嗎",
            "zh-Hans": "住三晚，对吗",
            "en": "Three nights, right"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "はい",
        "audio": "hotel-check-in.nights.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「泊」是晚：1泊（いっぱく）、2泊（にはく）、3泊（さんぱく）。「お間違いない」是確認沒錯。房型也可能一起確認，「シングル」是單人房，「ツイン」是兩張床。對的話說「はい」。",
        "zh-Hans": "「泊」是晚：1泊（いっぱく）、2泊（にはく）、3泊（さんぱく）。「お間違いない」是确认没错。房型也可能一起确认，「シングル」是单人房，「ツイン」是两张床。对的话说「はい」。",
        "en": "泊 counts nights: 1泊 (ippaku), 2泊 (nihaku), 3泊 (sanpaku). お間違いない asks if it is correct. The room type may come up too: シングル is a single, ツイン has two beds. Say はい if it is right."
      },
      "wordIds": [
        "bed"
      ]
    },
    {
      "id": "hotel-check-in.passport",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂櫃台要看護照",
