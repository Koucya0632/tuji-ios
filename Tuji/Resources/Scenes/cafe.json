      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要加奶精或糖漿嗎",
            "zh-Hans": "要加奶精或糖浆吗",
            "en": "Milk or syrup"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "熱的還是冰的",
