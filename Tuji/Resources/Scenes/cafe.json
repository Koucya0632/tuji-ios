  "title": {
    "zh-Hant": "咖啡廳",
    "zh-Hans": "咖啡店",
    "en": "Café"
  },
  "summary": {
    "zh-Hant": "點一杯咖啡會被問的六件事",
    "zh-Hans": "点一杯咖啡会被问的六件事",
    "en": "Six things you are asked when ordering a coffee"
  },
  "questions": [
    {
      "id": "cafe.seat-first",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問位子找好了沒",
        "zh-Hans": "听懂店员问座位找好了没",
        "en": "Understand when the staff ask if you have a seat"
      },
      "phrasings": [
        {
          "id": "cafe.seat-first.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "お席はお決まりですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "cafe.seat-first.p1.mp3"
        },
        {
          "id": "cafe.seat-first.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "先にお席の確保をお願いします",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "cafe.seat-first.p2.mp3"
        },
        {
          "id": "cafe.seat-first.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "お席、お取りいただいてますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "cafe.seat-first.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "位子找好了嗎",
            "zh-Hans": "座位找好了吗",
            "en": "Do you have a seat"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "點好了嗎",
            "zh-Hans": "点好了吗",
            "en": "Are you ready to order"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "內用還是外帶",
            "zh-Hans": "堂食还是外带",
            "en": "Eating here or taking out"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "まだです／取ってあります",
        "audio": "cafe.seat-first.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「お席」是座位。人多的時候會請你先找好位子再點。這裡的「お決まり」問的是位子，不是點餐。還沒找就說「まだです」。",
        "zh-Hans": "「お席」是座位。人多的时候会请你先找好座位再点。这里的「お決まり」问的是座位，不是点单。还没找就说「まだです」。",
        "en": "お席 means a seat. When it is busy, cafés ask you to find a seat before ordering. Here お決まり is about the seat, not your order. Say まだです if you have not found one."
      },
      "wordIds": []
    },
    {
      "id": "cafe.eat-in",
