  "questions": [
    {
      "id": "restaurant.party-size",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問幾位",
        "zh-Hans": "听懂店员问几位",
        "en": "Understand when the staff ask how many people"
      },
      "phrasings": [
        {
          "id": "restaurant.party-size.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "何名様ですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "restaurant.party-size.p1.mp3"
        },
        {
          "id": "restaurant.party-size.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "何名様でしょうか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "restaurant.party-size.p2.mp3"
        },
        {
          "id": "restaurant.party-size.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "何名様でいらっしゃいますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "restaurant.party-size.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "請問幾位",
            "zh-Hans": "请问几位",
            "en": "How many people"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "內用還是外帶",
            "zh-Hans": "堂食还是外带",
            "en": "Eating here or taking out"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "點好了嗎",
            "zh-Hans": "点好了吗",
            "en": "Are you ready to order"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "二人です",
        "audio": "restaurant.party-size.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「何名様」是問幾位。說人數加「です」，例如「二人です」，也可以直接比手指。",
        "zh-Hans": "「何名様」是问几位。说人数加「です」，例如「二人です」，也可以直接比手指。",
        "en": "何名様 asks how many people. Say the number with です, like 二人です, or show it with your fingers."
      },
      "wordIds": []
    },
