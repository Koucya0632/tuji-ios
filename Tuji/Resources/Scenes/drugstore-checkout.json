  "stage": {
    "routes": [
      {
        "id": "main",
        "title": {
          "zh-Hant": "伴手禮和藥",
          "zh-Hans": "伴手礼和药",
          "en": "Gifts and medicine"
        },
        "intent": {
          "zh-Hant": "你買了要送朋友的伴手禮和自己要吃的藥。沒有集點卡，也不想辦。要辦免稅，護照帶著。自己帶了購物袋，但要三個小袋分給朋友。想用交通卡付款。",
