  },
  "summary": {
    "zh-Hant": "藥妝店結帳時會被問的六件事",
    "zh-Hans": "药妆店结账时会被问的六件事",
    "en": "Six things you are asked at a drugstore checkout"
  },
  "questions": [
    {
      "id": "drugstore-checkout.point-card",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問有沒有集點卡或會員 App",
        "zh-Hans": "听懂店员问有没有积分卡或会员 App",
        "en": "Understand when the clerk asks for a points card or the store app"
      },
      "phrasings": [
        {
          "id": "drugstore-checkout.point-card.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "ポイントカードはお持ちですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "drugstore-checkout.point-card.p1.mp3"
        },
        {
          "id": "drugstore-checkout.point-card.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "アプリのご提示はございますか？",
          "voice": "Puck",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "drugstore-checkout.point-card.p2.mp3"
        },
        {
          "id": "drugstore-checkout.point-card.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "会員証はお持ちでしょうか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "drugstore-checkout.point-card.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要辦免稅",
            "zh-Hans": "要不要办免税",
            "en": "Do you want tax-free"
          },
          "correct": false
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "有沒有集點卡或會員 App",
            "zh-Hans": "有没有积分卡或会员 App",
            "en": "Do you have a points card or the app"
          },
          "correct": true
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要袋子",
            "zh-Hans": "要不要袋子",
            "en": "Do you need a bag"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "持っていません",
        "audio": "drugstore-checkout.point-card.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「ポイントカード」「会員証」是集點卡或會員卡，「アプリのご提示」是請你打開店家的 App 給他看。沒有就說「持っていません」。",
        "zh-Hans": "「ポイントカード」「会員証」是积分卡或会员卡，「アプリのご提示」是请你打开店里的 App 给他看。没有就说「持っていません」。",
        "en": "ポイントカード and 会員証 are points or member cards. アプリのご提示 asks you to show the store's app. Say 持っていません if you have none."
      },
      "wordIds": [
        "point-card",
        "membership-card",
        "app"
      ]
    },
    {
      "id": "drugstore-checkout.tax-free",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問要不要辦免稅",
        "zh-Hans": "听懂店员问要不要办免税",
        "en": "Understand when the clerk asks if you want tax-free"
      },
      "phrasings": [
        {
          "id": "drugstore-checkout.tax-free.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "免税のご利用ですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "drugstore-checkout.tax-free.p1.mp3"
        },
        {
          "id": "drugstore-checkout.tax-free.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "パスポートはお持ちですか？",
          "voice": "Charon",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "drugstore-checkout.tax-free.p2.mp3"
        },
        {
          "id": "drugstore-checkout.tax-free.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "免税のお手続きはされますか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "drugstore-checkout.tax-free.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "要不要辦免稅",
            "zh-Hans": "要不要办免税",
            "en": "Do you want tax-free"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "有沒有集點卡",
            "zh-Hans": "有没有积分卡",
            "en": "Do you have a points card"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要不要分開結帳",
            "zh-Hans": "要不要分开结账",
            "en": "Do you want to pay separately"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "お願いします／大丈夫です",
        "audio": "drugstore-checkout.tax-free.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「免税」是免稅，問你「パスポート」也是在問要不要辦。2026 年 11 月起改成先付含稅價，出境時經海關確認後再退稅。細節依店家／規定不同，以現場說明為準。要辦就拿出護照說「お願いします」。",
        "zh-Hans": "「免税」是免税，问你「パスポート」也是在问要不要办。2026 年 11 月起改成先付含税价，出境时经海关确认后再退税。细节依店家／规定不同，以现场说明为准。要办就拿出护照说「お願いします」。",
        "en": "免税 means tax-free, and being asked for your パスポート means the same thing. From November 2026 you pay the price with tax and get the tax back after customs checks your goods as you leave Japan. Details differ by store and by the rules, so follow what the staff tell you. To use it, show your passport and say お願いします."
      },
      "wordIds": [
        "passport"
      ],
      "reviewNote": "2026-11 リファンド方式：藥妝店收銀台是否仍這樣問、新制流程的一句描述，要請熟新免稅制的人核對。"
    },
    {
      "id": "drugstore-checkout.medicine-user",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問藥是誰要用",
        "zh-Hans": "听懂店员问药是谁要用",
        "en": "Understand when you are asked who will use the medicine"
      },
      "phrasings": [
        {
          "id": "drugstore-checkout.medicine-user.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "こちらのお薬、お使いになるのはご本人様ですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
