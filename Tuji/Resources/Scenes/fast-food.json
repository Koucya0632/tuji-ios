  "questions": [
    {
      "id": "fast-food.eat-in",
      "kind": "listening",
      "goal": {
        "zh-Hant": "聽懂店員問內用還是外帶",
        "zh-Hans": "听懂店员问堂食还是外带",
        "en": "Understand when you are asked about eating here or taking out"
      },
      "phrasings": [
        {
          "id": "fast-food.eat-in.p1",
          "role": "first",
          "speaker": "clerk",
          "text": "こちらでお召し上がりですか、お持ち帰りですか？",
          "voice": "Aoede",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "fast-food.eat-in.p1.mp3"
        },
        {
          "id": "fast-food.eat-in.p2",
          "role": "review",
          "speaker": "clerk",
          "text": "店内ご利用でよろしいですか？",
          "voice": "Charon",
          "speed": "fast",
          "ambience": true,
          "screen": null,
          "audio": "fast-food.eat-in.p2.mp3"
        },
        {
          "id": "fast-food.eat-in.p3",
          "role": "review",
          "speaker": "clerk",
          "text": "テイクアウトでよろしいですか？",
          "voice": "Kore",
          "speed": "normal",
          "ambience": false,
          "screen": null,
          "audio": "fast-food.eat-in.p3.mp3"
        }
      ],
      "choices": [
        {
          "id": "a",
          "text": {
            "zh-Hant": "內用還是外帶",
            "zh-Hans": "堂食还是外带",
            "en": "Eating here or taking out"
          },
          "correct": true
        },
        {
          "id": "b",
          "text": {
            "zh-Hant": "要套餐還是單點",
            "zh-Hans": "要套餐还是单点",
            "en": "Meal or just the item"
          },
          "correct": false
        },
        {
          "id": "c",
          "text": {
            "zh-Hant": "要哪個尺寸",
            "zh-Hans": "要哪个尺寸",
            "en": "Which size"
          },
          "correct": false
        }
      ],
      "response": {
        "ja": "店内で／持ち帰りで",
        "audio": "fast-food.eat-in.response.mp3",
        "voice": "Orus"
      },
      "explanation": {
        "zh-Hant": "「こちらで」「店内」是在店裡吃，「お持ち帰り」「テイクアウト」是外帶。回「店内で」或「持ち帰りで」。",
        "zh-Hans": "「こちらで」「店内」是在店里吃，「お持ち帰り」「テイクアウト」是外带。回「店内で」或「持ち帰りで」。",
        "en": "こちらで and 店内 mean eating here, お持ち帰り and テイクアウト mean taking it out. Answer 店内で or 持ち帰りで."
      },
      "wordIds": []
    },
