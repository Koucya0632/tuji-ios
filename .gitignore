# =============================================================================
# Tuji iOS — .gitignore
# 基底：github/gitignore/Swift + Objective-C，加上專案特定規則
# =============================================================================

# ---------- macOS / Finder ----------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes


# ---------- Xcode：使用者本地狀態 ----------
# 每個開發者各自的視窗 / breakpoint / scheme 排序，不該進 repo
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# 共用的 scheme 要進 repo（CI 才能跑），所以不忽略 xcshareddata/
# 例外清單寫在底下


# ---------- Xcode：建置產物 ----------
build/
# pr.yml 的 release-build job 用的 derivedDataPath。本機跟著跑
# 「出得了版本嗎」那一步時會留下來。
build-release/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.app
*.app.dSYM
*.xcarchive


# ---------- Swift Package Manager ----------
.swiftpm/
.build/
# CI 固定的 SPM checkout 目錄（-clonedSourcePackagesDirPath，見 pr.yml）。
# 本機照同樣的指令跑過也會留下來，1.4 GB。
SourcePackages/

Package.resolved
# 例外：工作區那一份 Package.resolved 進 repo，白名單在檔尾「例外清單」。
#
# 原本採「不進 repo」策略。代價是 CI 每趟都重新解析，而專案用的是
# upToNextMajorVersion、KeychainAccess 更是直接釘 branch master —— 等於
# 「上游今天有沒有推 commit」會決定 main 是綠還是紅，而且 CI 編譯的跟開發機
# 根本不是同一組版本。2026-11-05 的一趟 CI 比本機新了八個套件
# （supabase-swift 2.47.0→2.55.6、Nuke 13.0.6→13.2.1、xctest-dynamic-overlay
# 1.9.0→1.13.1、GoogleUtilities 8.1.0→8.1.5 ...），沒有人改過任何一行。
#
# 進 repo 之後它也是 SPM cache 的 key 來源：沒有這個檔，
# `hashFiles('**/Package.resolved')` 算出來是空字串，key 變成固定的
# `spm-macOS-X64-`，換套件不會換 key。


# ---------- CocoaPods（若未來真的需要才用，預設不開）----------
Pods/
*.xcworkspace
!default.xcworkspace
# 例外：如果整個專案結構就是 workspace，下面那行要拿掉
# 用 SPM 的情況不會有 Podfile


# ---------- Carthage（不使用，列出避免誤入）----------
Carthage/Build/
Carthage/Checkouts/


# ---------- fastlane ----------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
fastlane/README.md
# 審查用的示範帳號密碼、電話、信箱。metadata_download 會一起抓下來，不進 repo。
fastlane/metadata/review_information/


# ---------- 機密 / 設定 ----------
# 環境變數 / API key / 簽章金鑰一律不進 repo
Config/Secrets.xcconfig
Config/*.local.xcconfig
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
*.pem
GoogleService-Info.plist
.env
.env.*
!.env.example

# 例外：範本 / 公開版本要進 repo（讓新人知道有哪些 key 要填）
!Config/Secrets.xcconfig.example
!Config/Debug.xcconfig
!Config/TestFlight.xcconfig
!Config/Release.xcconfig
!Config/Version.xcconfig
# Firebase's Apple configuration contains client identifiers, not a server
# secret. The production file is reviewed and committed for reproducible builds.
!Tuji/GoogleService-Info.plist


# ---------- 編譯器 / IDE 雜檔 ----------
# AppCode
.idea/

# VS Code（若有人用來看 Swift）
.vscode/

# Cursor / 其他編輯器
.cursor/

# Vim / Emacs swap files
*.swp
*~
.\#*


# ---------- 截圖 / 暫存 / 工具雜物 ----------
# 開發過程隨手存的 reference / 截圖
/scratch/
/tmp/
*.tmp.png
*.tmp.mov

# 模擬器錄影
*.simulator.mov

# Sketch / Figma export 暫存
*.sketch~
*.fig~


# ---------- Tuji 專案特定 ----------
# 設計 reference 大檔（要的話放專案外或 LFS）
ReferenceAssets/

# Supabase CLI 的本地連結暫存（`supabase link` 產物，含 project ref）
supabase/.temp/

# 本地 backup
*.bak
*.orig


# ---------- 例外清單（共用 / 必進 repo 的）----------
# 預設都被上面規則排除，這裡白名單拉回
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/

# 共用的 Scheme（CI 要靠這個跑）— 上面 xcuserdata 已排除，明列確保
!**/xcshareddata/xcschemes/*.xcscheme

# 鎖依賴版本的 Package.resolved（理由見上面 SPM 那段）。
# 整個 project.xcworkspace 被 *.xcworkspace 排除掉了，而 git 不能在父目錄被
# 排除的情況下 re-include 裡面的檔案 —— 上面那兩條 `!*.xcworkspace/...` 其實
# 從來沒生效過，就是這個原因。所以目錄要一層一層拉回來，再把每一層其餘的
# 內容關掉：只開這一個檔，contents.xcworkspacedata 與 xcshareddata/ 底下的
# 本機狀態（IDEWorkspaceChecks、WorkspaceSettings）維持現狀不進 repo。
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
